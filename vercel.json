{
  "version": 2,
  "functions": {
    "api/anime.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/anime.html"
    },
    {
      "source": "/api/anime",
      "destination": "/api/anime.js"
    }
  ],
  "crons": [
    {
      "path": "/api/anime",
      "schedule": "*/10 * * * *"
    }
  ]
}
